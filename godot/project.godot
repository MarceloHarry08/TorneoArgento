; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Torneo Argento 16-Bit"
config/description="Juego de peleas arcade retro con 16 personajes icónicos de la cultura argentina"
run/main_scene="res://scenes/ui/intro_screen.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GlobalInputs="*res://scripts/global_inputs.gd"
GameData="*res://scripts/game_data.gd"
SoundEngine="*res://scripts/sound_engine.gd"
GameManager="*res://scripts/ui/game_manager.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

