[connection signal="pressed" from="MenuButtons/ArcadeButton" to="." method="_on_arcade_button_pressed"]
[connection signal="pressed" from="MenuButtons/VersusButton" to="." method="_on_versus_button_pressed"]
[connection signal="pressed" from="MenuButtons/ControlsButton" to="." method="_on_controls_button_pressed"]
