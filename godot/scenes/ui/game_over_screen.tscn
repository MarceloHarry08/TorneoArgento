[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/ui/game_over_screen.gd" id="1_over"]
[ext_resource type="FontFile" path="res://assets/ui/PressStart2P.ttf" id="2_font"]
[ext_resource type="Shader" path="res://scripts/crt_shader.gdshader" id="3_crt"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_crt"]
shader = ExtResource("3_crt")
shader_parameter/scanline_count = 180.0
shader_parameter/scanline_intensity = 0.12
shader_parameter/vignette_intensity = 0.2

[node name="GameOverScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
